# --- Local (npm run dev) ---
# Optional. Without this, AI feedback uses the built-in text fallback.
GEMINI_API_KEY=

# Leave empty for local same-origin API (Express + Vite on :3000).
VITE_API_URL=

# --- Render (API) ---
# Neon pooled connection string (sslmode=require).
DATABASE_URL=
# Set to false only for a local Postgres without SSL.
DATABASE_SSL=
# Comma-separated browser origins, e.g. https://studentport.vercel.app
FRONTEND_ORIGIN=
PORT=3000
NODE_ENV=
# Render should keep this false (Vercel hosts the UI).
SERVE_STATIC=false
