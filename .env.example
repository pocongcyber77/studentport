# =============================================================================
# Studentport — environment map (Vercel + Neon, tanpa Render)
# Repo: https://github.com/pocongcyber77/studentport
# Copy to .env or use `neon env pull` → .env.local for local dev.
# =============================================================================
#
# Architecture
#   Browser  →  Vercel (static UI + /api serverless)   https://vercel.com
#                  ↓
#            Neon Free (Postgres)                       https://console.neon.tech
#                  ↓
#            Gemini API (optional)                      https://aistudio.google.com/apikey
#
# Health (production): https://<app>.vercel.app/api/health
# =============================================================================
#
# WHERE TO PASTE
#   Vercel  → Settings → Environment Variables (DATABASE_URL, GEMINI_API_KEY, …)
#   Local   → .env.local (recommended after `neon env pull`) or .env
#   Neon    → dashboard only; copy connection string into Vercel / .env.local
#
# JANGAN set VITE_API_URL di Vercel kecuali API di host lain (biasanya tidak perlu).
# =============================================================================


# GEMINI — optional (server only; never VITE_*)
GEMINI_API_KEY=

# Browser API base — leave empty so /api hits same origin (Vercel or localhost:3000)
VITE_API_URL=

# Neon Postgres — required on Vercel; optional locally (else JSON file store)
DATABASE_URL=

# SSL for pg driver — leave empty for Neon (defaults to SSL on)
DATABASE_SSL=

# Optional CORS allow-list (production Vercel URL). *.vercel.app is already allowed.
FRONTEND_ORIGIN=

# Local dev port (Vercel injects its own)
PORT=3000

# Local: leave empty. Vercel sets production automatically.
NODE_ENV=

# Only if you serve dist + API from one Node process (not used on Vercel)
SERVE_STATIC=false

# =============================================================================
# CHECKLIST
# [ ] Neon: project + pooled DATABASE_URL
# [ ] Vercel: DATABASE_URL (+ GEMINI_API_KEY optional), redeploy
# [ ] Local: neon env pull, npm run dev, log shows Postgres (Neon)
# [ ] /api/health → storage: "neon"
# =============================================================================
